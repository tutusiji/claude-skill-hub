# ════════════════════════════════════════════════════════════════
# Skill Hub — 环境配置示例（模板）
# ════════════════════════════════════════════════════════════════
# 用法：cp .env.example .env.local 后填入真实值。
# 注意：真实密码/地址只写入被 git 忽略的 .env.local / .env.*.local，
#       不要提交到仓库（仓库内的 .env.* 与 .env.example 仅保留占位示例）。

# ── 端口 ──
# 开发模式: PORT=7788 npm run dev
# 生产模式: PORT=7788 npm run start
# Docker:   docker run -p 7788:3000 skill-hub-web
PORT=7788

# ── 管理员账号 ──
ADMIN_USERNAME=admin
# 占位值 change-me 仅为示例，真实密码请改为强密码
ADMIN_PASSWORD=change-me
# JWT 签名密钥：生成一个随机长字符串，例如 openssl rand -base64 32
JWT_SECRET=change-me

# ── 数据与存储目录 ──
DATA_DIR=/opt/skill-hub/data
UPLOAD_DIR=/opt/skill-hub/uploads
# 静态插件目录（内置插件所在目录，按部署实际路径填写）
STATIC_PLUGINS_DIR=/opt/skill-hub/plugins

# ── 站点与 marketplace 地址 ──
# 站点根地址（公开访问入口，替换为你的实际地址和端口）
NEXT_PUBLIC_APP_URL=http://your-internal-host:7504
# marketplace git 仓库地址（可选）
# 未配置时由 NEXT_PUBLIC_APP_URL 自动推导为 {APP_URL}/skill-hub.git
NEXT_PUBLIC_MARKETPLACE_URL=http://your-internal-host:7504/skill-hub.git
# marketplace 名称（可选，默认 skill-hub，用于推导仓库地址和 install 命令中的 @name）
# NEXT_PUBLIC_MARKETPLACE_NAME=skill-hub

# ── AI 审查 LLM（大模型配置）──
# 管理员可在后台「大模型配置」页运行期配置（保存到 data/llm-config.json，优先于以下环境变量）
# 未在后台保存配置时，以下环境变量作为回退（仅 OpenAI 兼容格式）
# AI_REVIEW_API_URL=https://api.openai.com/v1
# AI_REVIEW_API_KEY=
# AI_REVIEW_MODEL=gpt-4o-mini
