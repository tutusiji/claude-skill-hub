# 内网生产环境（HTTP only）
# 模板示例：真实值请在服务器上写入被 git 忽略的 .env.internal.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me
DATA_DIR=/opt/skill-hub/data
UPLOAD_DIR=/opt/skill-hub/uploads
STATIC_PLUGINS_DIR=/opt/skill-hub/plugins
NEXT_PUBLIC_APP_URL=http://your-internal-host:7504
NEXT_PUBLIC_MARKETPLACE_URL=http://your-internal-host:7504/skill-hub.git
